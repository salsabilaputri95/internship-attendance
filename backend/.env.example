# Application Configuration
APP_PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080

# PostgreSQL Database (Local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bps_attendance
DB_SSLMODE=disable

# JWT Authentication
JWT_SECRET=bps_attendance_secret_jwt_2026_super_secure_key

# Storage (local or s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# S3 Configuration (Optional for production / MinIO)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=bps-attendance-photos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
